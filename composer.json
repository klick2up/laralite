{
    "name": "laralite/framework",
    "description": "Laralite Micro-Framework built with standalone Illuminate components",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Laralite\\": "src/"
        },
        "files": [
            "bootstrap/helpers.php"
        ]
    },
    "require": {
        "php": "^8.2",
        "vlucas/phpdotenv": "^5.6",
        "illuminate/container": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/events": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/pipeline": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/mail": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "symfony/mailer": "^7.0|^8.0"
    }
}
